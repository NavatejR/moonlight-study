# OS / machine-specific
.DS_Store

# Freebuff workspace metadata (local tooling)
.freebuff/
Thumbs.db
Desktop.ini
*.log

# On-device model/toolchain downloads (GGUFs are cached by llamadart at
# runtime; never commit them). Root-anchored so app/lib/features/models/ —
# the Models screen source — is still tracked.
/models/
/toolchains/

# Environment / secrets
.env
.env.*
*.local

# Editor / IDE metadata (app/.gitignore has a fuller app-level list)
.idea/
.idea/**
.vscode/
*.iml
*.ipr
*.iws
.flutter-plugins-dependencies

# Vibe / AI coding-agent files (internal tooling, not part of the product)
AGENTS.md
.claude/
CLAUDE.md
.cursor/
.cursorrules
.opencode/
opencode.json
opencode.jsonc
.windsurf/
.codeium/
.zed/
.mcp/
